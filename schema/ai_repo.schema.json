{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voilalz.github.io/uav-papers-with-code/schema/ai_repo.schema.json",
  "title": "UAV Papers with Code: data/ai_repos.yaml",
  "description": "AI 高星仓库栏目。cat 由 scripts/validate.py 对照 categories 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "repos"],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "full", "short"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "code": {"type": "string", "pattern": "^[A-Z]{2,4}$"},
          "full": {"type": "string", "minLength": 1},
          "short": {"type": "string", "minLength": 1, "maxLength": 8}
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cat", "zh", "added"],
        "properties": {
          "name": {"description": "GitHub owner/repo", "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
          "cat": {"type": "string"},
          "zh": {"type": "string", "minLength": 4, "maxLength": 120},
          "note": {"description": "页面上以提示色显示的备注", "type": "string", "minLength": 1},
          "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
