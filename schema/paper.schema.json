{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voilalz.github.io/uav-papers-with-code/schema/paper.schema.json",
  "title": "UAV Papers with Code: data/papers.yaml",
  "description": "schema_version 1。字段含义见 CONTRIBUTING.md；词表（subs、venue、kind）由 scripts/validate.py 对照 data/taxonomy.yaml 检查。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "kind", "name", "title", "authors", "venue", "year", "paper", "subs", "zh", "added"],
    "properties": {
      "id": {
        "description": "稳定主键：方法名小写连字符 + 年份，创建后不修改、不复用",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-(19|20)\\d{2}$"
      },
      "kind": {"type": "string"},
      "name": {"type": "string", "minLength": 1, "maxLength": 60},
      "title": {"type": "string", "minLength": 5},
      "authors": {"type": "string", "minLength": 2},
      "venue": {"type": "string"},
      "year": {"type": "integer", "minimum": 1990, "maximum": 2100},
      "paper": {"$ref": "#/$defs/url"},
      "ids": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "arxiv": {"type": "string", "pattern": "^\\d{4}\\.\\d{4,5}$"},
          "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"}
        }
      },
      "repos": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "official"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "official": {"type": "boolean", "description": "是否为论文作者发布的官方代码"}
          }
        }
      },
      "site": {"$ref": "#/$defs/url"},
      "subs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 12}},
      "note": {"type": "string", "minLength": 1, "maxLength": 40},
      "zh": {"type": "string", "minLength": 10, "maxLength": 120},
      "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    },
    "anyOf": [{"required": ["repos"]}, {"required": ["site"]}]
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"}
  }
}
