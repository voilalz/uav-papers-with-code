{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voilalz.github.io/uav-papers-with-code/schema/paper.schema.json",
  "title": "UAV Papers with Code: data/papers.yaml",
  "description": "schema_version 1。字段含义见 CONTRIBUTING.md；词表（subs、venue、kind）由 scripts/validate.py 对照 data/taxonomy.yaml 检查。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "kind", "name", "title", "authors", "venue", "year", "paper", "subs", "zh", "added"],
    "properties": {
      "id": {
        "description": "稳定主键：方法名小写连字符 + 年份，创建后不修改、不复用",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-(19|20)\\d{2}$"
      },
      "kind": {"type": "string"},
      "name": {"type": "string", "minLength": 1, "maxLength": 60},
      "title": {"type": "string", "minLength": 5},
      "authors": {"type": "string", "minLength": 2},
      "venue": {"type": "string"},
      "year": {"type": "integer", "minimum": 1990, "maximum": 2100},
      "paper": {"$ref": "#/$defs/url"},
      "ids": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "arxiv": {"type": "string", "pattern": "^\\d{4}\\.\\d{4,5}$"},
          "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"}
        }
      },
      "repos": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "official"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "official": {"type": "boolean", "description": "是否为论文作者发布的官方代码"},
            "repro": {"$ref": "#/$defs/repro"}
          }
        }
      },
      "site": {"$ref": "#/$defs/url"},
      "subs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 12}},
      "note": {"type": "string", "minLength": 1, "maxLength": 40},
      "zh": {"type": "string", "minLength": 10, "maxLength": 120},
      "evaluated_on": {"description": "在哪些已收录的数据集上做了评测，填数据集条目的 id", "$ref": "#/$defs/idlist"},
      "datasets": {"description": "随论文发布、且已收录的数据集，填数据集条目的 id", "$ref": "#/$defs/idlist"},
      "real_flight": {
        "description": "data 公开了真实飞行数据 / experiment 有真机飞行实验但未公开数据 / none 没有真机飞行（仅仿真或离线数据）",
        "enum": ["data", "experiment", "none"]
      },
      "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    },
    "anyOf": [{"required": ["repos"]}, {"required": ["site"]}]
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "idlist": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-(19|20)\\d{2}$"}
    },
    "versions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\d{1,2}\\.\\d{1,2}$"}
    },
    "repro": {
      "description": "人工确认的运行环境，逐项覆盖 repo_signals.json 的自动检测结果；没填的项表示未确认，页面继续显示自动推测",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "checked"],
      "properties": {
        "source": {"description": "readme 作者在 README / 文档中写明；tested 有人实际编译运行过；issue 来自 issue 或社区报告", "enum": ["readme", "tested", "issue"]},
        "checked": {"description": "核对日期", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "note": {"type": "string", "minLength": 1, "maxLength": 60},
        "ros": {"enum": ["ros1", "ros2", "both", "none"]},
        "ros_distro": {"type": "array", "minItems": 1, "uniqueItems": true,
                       "items": {"enum": ["indigo", "kinetic", "melodic", "noetic", "foxy", "galactic", "humble", "iron", "jazzy"]}},
        "ubuntu": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d{2}\\.04$"}},
        "cuda": {"description": "required 必需 / optional 可选（如只用于 GPU 加速或仿真渲染）/ none 不需要", "enum": ["required", "optional", "none"]},
        "cuda_version": {"$ref": "#/$defs/versions"},
        "px4": {"type": "boolean"},
        "px4_version": {"$ref": "#/$defs/versions"},
        "ardupilot": {"type": "boolean"},
        "docker": {"type": "boolean"},
        "launch_config": {"type": "boolean"},
        "calibration": {"type": "boolean"},
        "pretrained": {"type": "boolean"},
        "jetson": {"description": "作者写明或有人报告能在 Jetson 上运行", "type": "boolean"}
      }
    }
  }
}
